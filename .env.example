APP_NAME=Relaydesk
APP_ENV=development
POSTGRES_USER=relaydesk
POSTGRES_PASSWORD=relaydesk
POSTGRES_DB=relaydesk
DATABASE_URL=postgresql+asyncpg://relaydesk:relaydesk@postgres:5432/relaydesk
CORS_ORIGINS=http://localhost:3000
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
PORTAL_DOMAIN=localhost:3000
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
INBOUND_DOMAIN=inbound.localhost
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_USERNAME=relaydesk@localhost
IMAP_PASSWORD=relaydesk
IMAP_USE_SSL=false
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
SMTP_HOST=greenmail
SMTP_PORT=3025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_NAME=Relaydesk
